---
:url: "<%= ENV['FOREMAN_URL'] %>"
:ssl_ca: "/etc/ssl/foreman/ca.crt"
:ssl_cert: "/etc/ssl/foreman/tls.crt"
:ssl_key: "/etc/ssl/foreman/tls.key"
:puppetdir: "/opt/puppetlabs/server/data/puppetserver"
:puppetuser: "puppet"
:facts: true
:fact_extension: "json"
:timeout: 60
:report_timeout: 60
:report_retry_limit: 1
:threads: null